generator client {
  provider = "prisma-client-js"
}

datasource db {
  // provider = "sqlite"
  provider = "postgresql"
}

// 1. Menu
model Menu {
  id            Int        @id @default(autoincrement())
  nama_kategori String
  nama_makanan  String
  harga         Float
  gambar        String
  deskripsi     String?
  pedas         Int        @default(0)
  status        Boolean    @default(true)
  created_at    DateTime   @default(now())

  // Relasi ke Favorit (1 menu bisa ada di favorit)
  favorit       Favorit[]

  @@map("menu")
}

// 2. Pesanan
model Pesanan {
  id         Int      @id @default(autoincrement())
  nama       String
  item       String   
  total      Float
  status     String   @default("pending")
  created_at DateTime @default(now())

  @@map("pesanan")
}

// 3. Reservasi
model Reservasi {
  id         String   @id @default(uuid())
  user_id    String?  
  gerai      String
  nama       String
  telepon    String
  email      String
  tanggal    String
  jam        String?
  sesi       String
  vip        String?  @unique
  jumlah     Int
  ruangan    String
  catatan    String?
  status     String   @default("pending")
  created_at DateTime @default(now())
  meja_id     Int?
  nomor_meja  Int?

  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("reservasi")
}

model PengaturanRuangan {
  id         String   @id @default(uuid())
  gerai      String
  ruangan    String
  jumlah     Int?                   
  status     Boolean  @default(true)  

  @@unique([gerai, ruangan])
  @@map("pengaturan_ruangan")
}

// 4. Users
model User {
  id            String      @id @default(uuid())
  nama          String
  email         String      @unique
  password      String
  total_reserve Int         @default(0)
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now())

  reservasi     Reservasi[]

  @@map("users")
}

// 5. FAQ (Daftar FAQ yang tampil di halaman)
model Faq {
  id         Int      @id @default(autoincrement())
  pertanyaan String
  jawaban    String
  created_at DateTime @default(now())

  @@map("faq")
}

// 6. FAQ Pertanyaan (Pesan/pertanyaan baru dari form modal user)
model FaqPertanyaan {
  id         Int      @id @default(autoincrement())
  nama       String
  email      String
  pertanyaan String
  dibaca     Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("faq_pertanyaan")
}

// 7. Favorit (Top 5 Menu)
model Favorit {
  id         Int      @id @default(autoincrement())
  menu_id    Int
  slot       Int      
  created_at DateTime @default(now())

  menu       Menu     @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@map("favorit")
}

// 8. Konten Web (Hero & About Landing Page)
model KontenWeb {
  id         Int      @id @default(1)
  teks_hero  String?
  teks_about String?
  created_at DateTime @default(now())

  @@map("konten_web")
}

// 9. Konten Footer (Kontak & Media Sosial)
model KontenFooter {
  id            Int      @id @default(1)
  judul         String?
  copyright     String?
  link_ig       String?
  link_tiktok   String?
  link_wa       String?
  link_linkedin String?
  email         String?
  created_at    DateTime @default(now())

  @@map("konten_footer")
}

// 10. Maps (Titik Lokasi Gerai)
model Map {
  id         Int      @id @default(autoincrement())
  latitude   Float
  longitude  Float
  nama       String
  alamat     String
  created_at DateTime @default(now())

  @@map("maps")
}

// 11. Statistik (Counter Pengunjung - Row Tunggal ID: 1)
model Statistik {
  id                Int      @id @default(1)
  jumlah_pengunjung Int      @default(0)
  created_at        DateTime @default(now())

  @@map("statistik")
}

// 12. Pengaturan Orbit
model PengaturanOrbit {
  id        Int    @id @default(1)
  mode      String @default("manual")
  gerak     String @default("bertahap")
  kecepatan String @default("normal")
  bentuk    String @default("lingkaran")
  warna     String @default("#ffffff")

  @@map("pengaturan_orbit")
}


// 13. Kasir (Akun Kasir: satu akun hanya memiliki akses ke satu gerai)
model Kasir {
  id         String   @id @default(uuid())
  nama       String
  username   String   @unique
  password   String
  gerai      String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("kasir")
}

// 14. Reservasi Booking Table Schema
model Meja {
  id             Int        @id @default(autoincrement())
  gerai          String
  tipe           String     // indoor | outdoor | vip
  nomor          Int
  kapasitas_min  Int        @default(1)
  kapasitas_maks Int        @default(4)
  slots          MejaSlot[]

  @@unique([gerai, tipe, nomor])
}

model MejaSlot {
  id        Int     @id @default(autoincrement())
  meja_id   Int
  tanggal   String  // 'YYYY-MM-DD' atau '*' (berlaku semua tanggal)
  jam       String  // 'HH:MM' atau '*' (berlaku semua jam)
  published Boolean @default(false)
  open      Boolean @default(true)
  catatan   String  @default("") @db.VarChar(100)
  meja      Meja    @relation(fields: [meja_id], references: [id], onDelete: Cascade)

  @@unique([meja_id, tanggal, jam])
}